0 !LPUB INSERT PICTURE "../output/pages/mesh-kit_150_DPI_page_1.png" SCALE 0.6 OFFSET 0.05 0.2
0 STEP
0 !LPUB INSERT PAGE
0 !LPUB INSERT TEXT "TEST 02" "Arial,40,-1,5,75,0,0,0,0,0" "#191919" OFFSET 0.04 0.04
0 !LPUB INSERT PICTURE "../output/pages/mesh-kit_150_DPI_page_2.png" SCALE 0.6 OFFSET 0.05 0.2
0 STEP
0 NOFILE
